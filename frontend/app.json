{
  "expo": {
    "name": "FIT AI",
    "slug": "fit-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitai-app-icon.png",
    "scheme": "fitai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.globalaistudio.fitai",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Prendre une photo de repas ou personnaliser une carte de partage",
        "NSPhotoLibraryUsageDescription": "Sélectionner une photo de repas ou un fond de partage",
        "NSPhotoLibraryAddUsageDescription": "Enregistrer ta story de performance dans tes photos",
        "NSMotionUsageDescription": "Synchroniser tes pas depuis le podomètre du téléphone"
      }
    },
    "android": {
      "package": "com.globalaistudio.fitai",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fitai-app-icon.png",
        "backgroundColor": "#04170D"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fitai-app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#04170D"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accède à tes photos pour analyser tes repas.",
          "cameraPermission": "L'app utilise la caméra pour photographier tes repas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'app utilise la caméra pour photographier tes repas.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "subscriptions": {
        "ios": {
          "monthly": "fitai_premium_monthly",
          "annual": "fitai_premium_annual"
        },
        "android": {
          "monthly": "fitai_premium_monthly",
          "annual": "fitai_premium_annual"
        }
      },
      "eas": {
        "projectId": "79f780f1-9e98-428e-9a0f-f977ff18df71"
      }
    },
    "owner": "global_ai_studio",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/79f780f1-9e98-428e-9a0f-f977ff18df71"
    }
  }
}
